  boxrule=0pt,left=6pt,right=6pt,top=2pt,bottom=2pt,arc=0pt]\ifx&#1&\begin{bdefinitioninner}\else\begin{bdefinitioninner}[#1]\fi}
  {\end{bdefinitioninner}\end{tcolorbox}}
\newenvironment{bquote}{\begin{tcolorbox}[enhanced,breakable,colback=white,colframe=white,boxrule=0pt,
  borderline west={1.6pt}{0pt}{quotebar},left=10pt,right=4pt,top=1pt,bottom=1pt,arc=0pt,fontupper=\small\itshape]}
  {\end{tcolorbox}}
