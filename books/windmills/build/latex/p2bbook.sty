% ---- margin tags: where each statement comes from ----
% ---- source notes: a marker in the text, the note at the foot of the page ----
% Notes raised inside a box are queued and set when the outermost box closes, so they
% land at the foot of the page instead of inside the box.
% Markers are grey numbers in brackets, on the line (never raised, so never mistaken for an
% exponent), always placed in front of what they refer to, followed by a clear gap.
% The note at the foot of the page starts with the same bracketed number.
\newcount\bdepth
\newcounter{pendingnotes}

\renewcommand\@makefntext[1]{\noindent\scriptsize\raggedright
  \makebox[2.2em][l]{\normalfont\textcolor{srcgray}{[\@thefnmark]}}#1}
\newcommand{\srcmark}{\stepcounter{footnote}\protected@xdef\@thefnmark{\thefootnote}%
  \mbox{\normalfont\textcolor{srcgray}{\footnotesize[\thefootnote]}}\hspace{0.9em}\ignorespaces}
\newcommand{\bpush}{\global\advance\bdepth 1\relax}
\newcommand{\bpop}{\global\advance\bdepth -1\relax\ifnum\bdepth=0 \flushsrcnotes\fi}
\newcommand{\srcnote}[1]{\srcmark\stepcounter{pendingnotes}%
  \expandafter\gdef\csname pnote@\arabic{pendingnotes}\endcsname{#1}%
  \expandafter\xdef\csname pnum@\arabic{pendingnotes}\endcsname{\arabic{footnote}}\ignorespaces}
\newcommand{\flushsrcnotes}{\ifnum\value{pendingnotes}>0 \@tempcnta=0
  \loop\advance\@tempcnta 1
    \footnotetext[\csname pnum@\the\@tempcnta\endcsname]{\csname pnote@\the\@tempcnta\endcsname}%
  \ifnum\@tempcnta<\value{pendingnotes}\repeat
  \setcounter{pendingnotes}{0}\fi}
\newcommand{\srccitenote}[1]{\ifnum\bdepth=0 \srcmark\footnotetext[\arabic{footnote}]{#1}\ignorespaces\else\srcnote{#1}\fi}

\newcommand{\srcok}[3]{\textcolor{srcgray}{\textsf{Source:} \texttt{#1}\ifx&#2&\else, #2\fi}}
\newcommand{\srcbad}[1]{\textcolor{unsourced}{\textbf{\textsf{LEDGER CHECK FAILED}} (#1)}}
\newcommand{\unsourced}{\textcolor{unsourced}{\textbf{\textsf{UNSOURCED}}}}
\newcommand{\leanok}[1]{\textcolor{leangreen}{\textsf{Lean \checkmk} \texttt{\detokenize{#1}}}}
\newcommand{\leanbad}[1]{\textcolor{unsourced}{\textsf{Lean \crossmk} \texttt{\detokenize{#1}}}}
\newcommand{\leanpending}[1]{\textcolor{srcgray}{\textsf{not yet formally checked:} \texttt{\detokenize{#1}}}}
\newcommand{\srccite}[2]{\textcolor{srcgray}{\textsf{Source:} \texttt{#1}\ifx&#2&\else, #2\fi}}
\newcommand{\derivedtag}[1]{\textcolor{srcgray}{\textsf{Derived here} from #1}}

% ---- the paper's HOL4 notation, so quotations from its LaTeX source print as in the paper ----
\providecommand{\HOLinline}[1]{\ensuremath{#1}}
\providecommand{\HOLFreeVar}[1]{\mathit{#1}}
\providecommand{\HOLBoundVar}[1]{\mathit{#1}}
\providecommand{\HOLConst}[1]{\textsf{#1}}
\providecommand{\HOLSymConst}[1]{#1}
\providecommand{\HOLNumLit}[1]{#1}
\providecommand{\HOLKeyword}[1]{\textbf{\textsf{#1}}}
\providecommand{\HOLFieldName}[1]{\textsf{#1}}
\providecommand{\HOLTokenExists}{\exists}\providecommand{\HOLTokenForall}{\forall}\providecommand{\HOLTokenUnique}{\exists!}
\providecommand{\HOLTokenConj}{\land}\providecommand{\HOLTokenDisj}{\lor}\providecommand{\HOLTokenNeg}{\lnot}
\providecommand{\HOLTokenImp}{\Rightarrow}\providecommand{\HOLTokenEquiv}{\Leftrightarrow}\providecommand{\HOLTokenLambda}{\lambda}
\providecommand{\HOLTokenIn}{\in}\providecommand{\HOLTokenNotIn}{\notin}\providecommand{\HOLTokenLt}{<}\providecommand{\HOLTokenLeq}{\le}
\providecommand{\HOLTokenNotEqual}{\neq}\providecommand{\HOLTokenCompose}{\circ}\providecommand{\HOLTokenTurnstile}{\vdash}
\providecommand{\HOLTokenDefEquality}{\mathrel{\stackrel{\scriptscriptstyle\mathrm{def}}{=}}}
\providecommand{\HOLTokenLeftbrace}{\{}\providecommand{\HOLTokenRightbrace}{\}}\providecommand{\HOLTokenBar}{\mid}
\providecommand{\HOLTokenEmpty}{\emptyset}

